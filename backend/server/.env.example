# CareBridge UAE — local server config
# Copy to .env and fill in ONE provider key.

# Anthropic Claude (default for this project)
ANTHROPIC_API_KEY=

# ...or OpenAI (used automatically if ANTHROPIC_API_KEY is empty)
# OPENAI_API_KEY=

# Optional: override the model id
# CAREBRIDGE_MODEL=claude-3-5-sonnet-latest
# CAREBRIDGE_MODEL=gpt-4o-mini

# Optional: server port (default 8000)
# PORT=8000
